# Faculty Twin environment variables. Names only: put values in .env (git-ignored)
# for local dev, and in Vercel -> Project -> Settings -> Environment Variables.

# Narration model providers (the Settings page switches between them)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
LLM_PROVIDER=
LLM_MODEL=

# Embeddings (must match the model the index was built with)
VOYAGE_API_KEY=
VOYAGE_MODEL=

# Voice
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
DAILY_VOICE_CHAR_CAP=
# Free Microsoft voices (edge-tts, no key): daily character cap, default 200000
DAILY_FREE_VOICE_CHAR_CAP=
# Optional: EDGE_TTS_RATE (default -5%), EDGE_TTS_PITCH (default +0Hz)

# Supabase (private bucket for content; Postgres for counters, log, settings)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=

# Access and signing
STUDENT_PASSCODE=
ADMIN_PASSCODE=
SESSION_SECRET=
AUDIO_SIGNING_SECRET=

# Local dev only: folder holding content/, slides/, clips/, used instead of Supabase
CONTENT_DIR=

# Optional
# ELEVENLABS_MODEL_ID=
# PUBLIC_SITE_URL=

# Optional spend guards (defaults in app/config.py; see docs/SECURITY.md)
# DAILY_LLM_CALL_CAP=
# DAILY_EMBED_CAP=
# LLM_MAX_PROMPT_PRICE_PER_MTOK=
# LLM_MAX_COMPLETION_PRICE_PER_MTOK=

# Local dev only. FT_LOCAL_DEV=1 allows fixed dev signing keys when
# SESSION_SECRET / AUDIO_SIGNING_SECRET are unset; ignored in production.
# FT_LOCAL_DEV=
# FT_ENV=
